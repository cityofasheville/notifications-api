html
  head
    meta(charset="utf-8")
    meta(name="viewport", content="width=device-width")
    meta(http-equiv="X-UA-Compatible", content="IE=edge")
    meta(name="x-apple-disable-message-reformatting")

    title Development Notification
    style.
      .container {
        padding: 2rem 0;
      }
     .permit-list {
        list-style: none;
        padding: 0;
        margin: 2rem 0;
      }
      .mb-block {
        margin-bottom: 1rem;
      }
      ul li {
        margin-bottom: 0.5rem;
      }
  body
    div(class='container')
      h1(class='mb-block') New land development proposed in Asheville

      p() The City of Asheville began processing the following land development applications yesterday.  Click on a project name to view details.

      ul(class='permit-list')
        each val in listOfTopics
          li
            a(href='https://simplicity.ashevillenc.gov/permits/'+val.permit_num) #{val.name} - #{val.notification_type}
            if val.in_legacy_neighborhood
              span()= ' (in legacy neighborhood)'

      p(class='mb-block') You are receiving this email because you signed up for notifications.  No longer interested?
      
      ul
        li
          a(href=unsub_url) Unsubscribe
        li
          a(href='https://notifications.ashevillenc.gov') Change your preferences
        li
          a(href='https://simplicity.ashevillenc.gov/development/major') Learn more about large-scale development in Asheville
